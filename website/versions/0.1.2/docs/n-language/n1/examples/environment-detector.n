// Deprecated N1: use N2 for new programs.
asm {
    ; Connect an Environment Detector to port 2 (north).
    PWRAP A, 2
    CALL wait_request
    PRESULT C
    PCALL A, 2, 0x420, 0, 0
    CALL wait_request
    CALL print_result
    PCALL A, 2, 0x42D, 0, 0
    CALL wait_request
    CALL print_result
    HLT
    
    print_result:
    PLEN B
    CMP B, 255
    JG failed
    PRESULTS C, 0x200, 256
    MOV D, 0x200
    print_text:
    CMP C, 0
    JZ done
    OUTC [D]
    INC D
    DEC C
    JMP print_text
    done:
    OUTC 10
    RET
    
    wait_request:
    CMP A, 1
    JNZ failed
    wait_pending:
    PSTATUS B
    CMP B, 2
    JZ ready
    CMP B, 1
    JNZ failed
    SLEEP 1
    JMP wait_pending
    ready:
    RET
    
    failed:
    PRESULT C
    OUT "Environment Detector request failed."
    HLT
}
