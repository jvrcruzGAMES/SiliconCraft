import <std>
import "entities/player.n2"

func main()
    print("Initializing Game...")

    local hero = GamePlayer("Alex", 10, 20)
    hero.display()

    print("Moving player...")
    hero.move(5, -2)
    hero.display()

    print("Game session complete.")
end
