// ============================================
// Program: 05_tables.n (N1 Standard)
// Description: Demonstrates indexed arrays and key-value tables
// ============================================

println "--- Tables Demo ---"

// Indexed table
var nums = { 10, 20, 30, 40 }
println nums[0]
println nums[2]
nums[1] = 99
println nums[1]

// Key-value table
var player = {
    name = "Steve",
    hp = 100,
    alive = true
}

println player.name
print "HP: "
println player.hp
player.hp -= 25
print "HP after damage: "
println player.hp
