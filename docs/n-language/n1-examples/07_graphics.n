// ============================================
// Program: 07_graphics.n (N1 Standard)
// Description: Framebuffer canvas drawing
// ============================================

// Switch to 16:9 framebuffer mode
display.mode(1)

// Clear screen with dark blue
fb.fill(0xFF000033)

// Draw a green border rectangle
fb.rect(10, 10, 108, 44, 0xFF00FF00)

// Draw diagonal crossed lines
fb.line(10, 10, 118, 54, 0xFFFF0000)
fb.line(10, 54, 118, 10, 0xFF00FFFF)

// Draw a white center pixel
fb.set(64, 32, 0xFFFFFFFF)

// Flip canvas
fb.flip()
