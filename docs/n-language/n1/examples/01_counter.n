// ============================================
// Program: 01_counter.n (N1 Standard)
// Description: Counts down from 5 to 1 and halts
// ============================================

println "=========================="
println "    COUNTDOWN DEMO (N1)   "
println "=========================="

var c = 5

while c > 0 {
    println c
    c--
}

println "Liftoff! SiliconCraft online."
